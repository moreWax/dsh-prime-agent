{
  "name": "@morewax/dsh-okf-knowledge",
  "description": "OKF/OpenWiki knowledge plugin for DeepSeek Harness: bundle pages as skills with provenance metadata",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreWax/dsh-prime-agent.git"
  },
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./invariant": {
      "types": "./lib/invariant.d.mts",
      "default": "./lib/invariant.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/invariant.mjs",
    "patches/okf-knowledge.patch.yml",
    "lib/*.d.mts",
    "lib/*.d.mts.map"
  ],
  "dsh": {
    "bundle": {
      "patch": "./patches/okf-knowledge.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/invariant.ts --format esm --dts --out-dir lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7",
    "@deepseek-ai/dsh-invariants": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.1",
    "@morewax/dsh-prime-agent-testkit": "workspace:*"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "knowledge",
    "okf",
    "openwiki"
  ],
  "engines": {
    "node": ">=22"
  }
}
