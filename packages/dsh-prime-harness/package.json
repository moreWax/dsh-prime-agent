{
  "name": "@your-scope/dsh-prime-harness",
  "description": "Prime Agent bridge for DeepSeek Harness: memory injection, skill serving, and turn export as native plugins",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<you>/dsh-prime-bridge.git",
    "directory": "packages/dsh-prime-harness"
  },
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.mts",
      "default": "./lib/invariant.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/invariant.mjs",
    "patches/prime-harness.patch.yml",
    "lib/types/**/*.d.mts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./patches/prime-harness.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/invariant.ts --format esm --dts --out-dir lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7",
    "@deepseek-ai/dsh-invariants": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
