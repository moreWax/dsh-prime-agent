{
  "name": "@morewax/dsh-remote-transport",
  "description": "Remote transport seam: exec + binary-safe file IO + interactive terminal over SSH or MOSH",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreWax/dsh-prime-bridge.git",
    "directory": "packages/remote/remote-transport"
  },
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.mts",
      "default": "./lib/invariant.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/invariant.mjs",
    "lib/types/**/*.d.mts"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/invariant.ts --format esm --dts --out-dir lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1"
  }
}
